class Solution:
    def findCheapestPrice(self, n: int, flights: List[List[int]], src: int, dst: int, k: int) -> int:
        dp = [float("inf")] * n
        dp[src] = 0
        for i in range(k+1):
            temp_dp = dp.copy()
            for s, d, p in flights:
                if dp[s] == float("inf"):
                    print(s, 'inf')
                    continue
                if  dp[s] + p < temp_dp[d]:
                    temp_dp[d] = dp[s] + p
            print(temp_dp)
            dp = temp_dp
        return -1 if dp[dst] == float("inf") else dp[dst]
